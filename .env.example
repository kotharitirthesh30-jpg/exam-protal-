# GEMINI_API_KEY: Optional/Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Server configuration
PORT=3000
JWT_SECRET="orbit-portal-jwt-secret-key-production-ready"

# Database: Optional MongoDB Connection String (defaults to built-in persistent disk storage if not configured)
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/orbit_exams?retryWrites=true&w=majority"
